datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  CUSTOMER
  SELLER
  SHG_PRODUCER
  STORE_MANAGER
  RIDER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum FulfilmentType {
  QUICK_COMMERCE      // 10-30 mins from local dark store
  STANDARD_MARKETPLACE // 2-4 days courier dispatch from seller/warehouse
  BOTH
}

enum StoreStatus {
  OPEN
  CLOSED
  MAINTENANCE
}

enum OrderStatus {
  PLACED
  PROCESSING
  PACKED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum LedgerEntryType {
  CREDIT_PURCHASE_CASHBACK
  CREDIT_DIRECT_REFERRAL_L1
  CREDIT_TEAM_REFERRAL_L2
  CREDIT_COMMUNITY_REFERRAL_L3
  CREDIT_PROMOTIONAL_BONUS
  DEBIT_ORDER_REDEMPTION
  DEBIT_EXPIRY
  REVERSAL_REFUND
}

enum LedgerEntryStatus {
  PENDING_RETURN_WINDOW
  CONFIRMED
  CANCELLED
}

// ----------------------------------------------------
// USER & PROFILE MODELS
// ----------------------------------------------------

model User {
  id              String            @id @default(uuid())
  memberId        String            @unique
  name            String
  phone           String            @unique
  email           String?           @unique
  passwordHash    String?
  role            Role              @default(CUSTOMER)
  referralCode    String            @unique
  referredById    String?
  referredBy      User?             @relation("UserReferrals", fields: [referredById], references: [id])
  downline        User[]            @relation("UserReferrals")
  level           String            @default("Silver") // Silver, Gold, Platinum, Diamond
  isActive        Boolean           @default(true)
  addresses       Address[]
  rewardAccount   RewardAccount?
  orders          Order[]
  sellerProfile   SellerProfile?
  assignedStoreId String?
  assignedStore   Store?            @relation("StoreStaff", fields: [assignedStoreId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([phone])
  @@index([referralCode])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("HOME") // HOME, WORK, OTHER
  fullAddress String
  landmark    String?
  city        String   @default("Ranchi")
  state       String   @default("Jharkhand")
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  orders      Order[]

  @@index([latitude, longitude])
  @@index([pincode])
}

// ----------------------------------------------------
// QUICK COMMERCE STORES & DARK STORES
// ----------------------------------------------------

model Store {
  id              String           @id @default(uuid())
  storeCode       String           @unique
  name            String
  city            String           @default("Ranchi")
  state           String           @default("Jharkhand")
  address         String
  latitude        Float
  longitude       Float
  deliveryRadiusKm Float           @default(5.0)
  status          StoreStatus      @default(OPEN)
  staff           User[]           @relation("StoreStaff")
  inventory       StoreInventory[]
  subOrders       SubOrder[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([latitude, longitude])
}

model StoreInventory {
  id                 String   @id @default(uuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityAvailable  Int      @default(0)
  quantityReserved   Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([storeId, productId])
}

// ----------------------------------------------------
// CATALOGUE & PRODUCTS
// ----------------------------------------------------

model Category {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String?
  imageUrl    String?
  type        FulfilmentType @default(QUICK_COMMERCE)
  sortOrder   Int            @default(0)
  products    Product[]
  createdAt   DateTime       @default(now())
}

model SellerProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  isSHG        Boolean   @default(false)
  shgGroupName String?
  gstin        String?
  fssaiNumber  String?
  city         String
  state        String
  isVerified   Boolean   @default(false)
  commissionPct Float    @default(5.0)
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Product {
  id             String           @id @default(uuid())
  sku            String           @unique
  name           String
  slug           String           @unique
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  unit           String           // e.g. "500 g", "1 Litre", "5 kg"
  mrp            Float
  bachatPrice    Float
  discountPct    Int              @default(0)
  cashbackPct    Float            @default(5.0) // Earned after delivery
  description    String?
  imageUrl       String
  isSHG          Boolean          @default(false)
  producerName   String?
  fulfilmentType FulfilmentType   @default(QUICK_COMMERCE)
  sellerId       String?
  seller         SellerProfile?   @relation(fields: [sellerId], references: [id])
  storeInventory StoreInventory[]
  orderItems     OrderItem[]
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([sku])
}

// ----------------------------------------------------
// ORDERS & SPLIT SHIPMENTS
// ----------------------------------------------------

model Order {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  addressId          String
  deliveryAddress    Address       @relation(fields: [addressId], references: [id])
  totalMRP           Float
  totalBachatPrice   Float
  savingsEarned      Float         @default(0)
  deliveryFee        Float         @default(0)
  creditsApplied     Float         @default(0)
  finalPayable       Float
  paymentStatus      PaymentStatus @default(PENDING)
  paymentMethod      PaymentMethod @default(UPI)
  orderStatus        OrderStatus   @default(PLACED)
  deliveryOtp        String?       // 4-digit verification OTP
  gatewayOrderId     String?
  gatewayPaymentId   String?
  items              OrderItem[]
  subOrders          SubOrder[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([orderNumber])
}

// Split Shipment for Multi-Store / Multi-Seller fulfilment
model SubOrder {
  id             String        @id @default(uuid())
  subOrderNumber String        @unique
  parentOrderId  String
  parentOrder    Order         @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id])
  sellerId       String?
  fulfilmentType FulfilmentType
  status         OrderStatus   @default(PLACED)
  trackingNumber String?
  assignedRiderPhone String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([parentOrderId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitMRP        Float
  unitBachatPrice Float
  cashbackEarned Float    @default(0)
}

// ----------------------------------------------------
// IMMUTABLE REWARDS & SAVINGS LEDGER (DOUBLE-ENTRY)
// ----------------------------------------------------

model RewardAccount {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance               Float          @default(0)
  totalSavings          Float          @default(0)
  totalCashbackEarned   Float          @default(0)
  totalReferralEarned   Float          @default(0)
  lifetimeEarned        Float          @default(0)
  entries               RewardLedger[]
  updatedAt             DateTime       @updatedAt
}

model RewardLedger {
  id                String            @id @default(uuid())
  accountId         String
  account           RewardAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionRef    String            @unique
  orderId           String?
  entryType         LedgerEntryType
  status            LedgerEntryStatus @default(CONFIRMED)
  amount            Float             // Positive for Credit, Negative for Debit
  runningBalance    Float
  title             String
  description       String
  smartChainHash    String?           // Cryptographic hash audit verification
  createdAt         DateTime          @default(now())

  @@index([accountId])
  @@index([transactionRef])
}

// ----------------------------------------------------
// AUTH & OTP
// ----------------------------------------------------

model OtpVerification {
  id         String    @id @default(uuid())
  identifier String    // Mobile phone or email
  code       String
  purpose    String    // LOGIN, REGISTRATION, WITHDRAWAL
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier])
}

// ----------------------------------------------------
// HYPERLOCAL ROUTING ENGINE MODELS
// ----------------------------------------------------

model ServiceablePincode {
  id               String   @id @default(uuid())
  pincode          String   @unique
  city             String   @default("Ranchi")
  state            String   @default("Jharkhand")
  deliveryActive   Boolean  @default(true)
  pickupActive     Boolean  @default(true)
  deliveryRadiusKm Decimal  @default(5.0) @db.Decimal(4, 1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([pincode])
}

model RoutingRule {
  id          String   @id @default(uuid())
  name        String
  priority    Int      @default(100)
  conditions  Json     // Conditions like pincode matches, cart value threshold, SHG exclusivity
  actions     Json     // Preferred shop boosts, filter overrides
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([priority, isActive])
}

model RoutingAuditLog {
  id              String   @id @default(uuid())
  orderId         String
  attemptNumber   Int      @default(1)
  pincode         String
  fulfilmentType  String   // DELIVERY, PICKUP
  candidateCount  Int
  excludedShops   Json     // Array of { shop_id, filter, reason }
  scoredShops     Json     // Array of { shop_id, score, factors }
  selectedShopId  String?
  selectionReason String   // HIGHEST_SCORE, CUSTOMER_CHOICE, NO_SHOP_AVAILABLE
  reservationIds  Json?
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([pincode])
  @@index([createdAt])
}

model RoutingConfig {
  id                    String   @id @default(uuid())
  key                   String   @unique @default("DEFAULT")
  weights               Json     // { distance: 0.25, rating: 0.15, ... }
  acceptanceSlaMinutes  Int      @default(5)
  pickingSlaMinutes     Int      @default(15)
  softReservationTtlMin Int      @default(15)
  maxRerouteAttempts    Int      @default(3)
  closingBufferMinutes  Int      @default(15)
  antiStarvationDays    Int      @default(7)
  antiStarvationBonus   Decimal  @default(0.05) @db.Decimal(4, 2)
  updatedBy             String   @default("Super Admin")
  updatedAt             DateTime @updatedAt
}

