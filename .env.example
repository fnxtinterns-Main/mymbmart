# MegaBachatMart — Local & Staging Environment Template

# Node Environment
NODE_ENV=development
PORT=3000

# Database (Postgres 15+ with pgcrypto & pg_trgm)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/megabachatmart?schema=public"

# Redis (v7+)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="mbm_master_jwt_secret_key_change_in_production_2026"
JWT_REFRESH_SECRET="mbm_master_refresh_secret_key_2026"
NEXT_PUBLIC_ADMIN_PIN="MBM@Admin2026"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="megabachatmart-media"

# Sentry Observability (Optional in local dev)
SENTRY_DSN=""

# External Gateways (Stubs in Dev)
RAZORPAY_KEY_ID="rzp_test_stub"
RAZORPAY_KEY_SECRET="rzp_test_secret_stub"
MSG91_AUTH_KEY="stub_msg91_key"
